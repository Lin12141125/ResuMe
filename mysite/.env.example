DB_ENGINE=sqlite
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty only for local development; tokens expire on server restart.
DJANGO_SECRET_KEY=

# llm uses an external API. local is a limited, offline rule-based demo.
RESUME_PARSER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Used only when DB_ENGINE=mysql. Back up existing databases before migrating.
MYSQL_DATABASE=iras_database
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306